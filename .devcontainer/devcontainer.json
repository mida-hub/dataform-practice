{
  "name": "Dataform Development with Copilot",
  "dockerComposeFile": [
    "../docker-compose.yaml"
  ],
  "service": "dataform",
  "workspaceFolder": "/usr/app/dataform",
  "remoteUser": "node",
  "features": {
    "ghcr.io/dhoeric/features/google-cloud-cli:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot-chat",
        "ashishalex.dataform-lsp-vscode",
        "usernamehw.errorlens"
      ]
    }
  },
  "remoteEnv": {
    "CLOUDSDK_CORE_PROJECT": "bigquery-practice-482713",
    "CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT": "dataform-tools@bigquery-practice-482713.iam.gserviceaccount.com"
  },
  "postStartCommand": "cp -r /home/node/.config/gcloud_host/* /home/node/.config/gcloud/ && gcloud auth application-default login --impersonate-service-account=$CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT"
}
